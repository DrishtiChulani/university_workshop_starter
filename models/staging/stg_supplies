with source as (

    select * from {{ source('jaffle-shop-dc', 'raw_supplies') }}

),

renamed as (

    select
        id as supply_id,
        name as supply_name,
        cost as supply_cost,
        perishable as supply_perishable,
        sku as supply_sku
        -- Macro conversion to dollars
        {{ cents_to_dollars('cost') }} as supply_cost

    from source

)

select * from renamed